{
  "name": "@acegalaxy/lib-notion-vault",
  "version": "0.2.0",
  "description": "Load secrets from Notion vault databases into process.env. Supports multi-DB query, project/env filtering, alias expansion, in-memory TTL cache, and bootstrap row pattern.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "test": "node --test test/*.test.js",
    "pretest": "npm run build"
  },
  "keywords": [
    "notion",
    "vault",
    "secrets",
    "env",
    "config",
    "dotenv",
    "secret-management"
  ],
  "author": "ACE Galaxy <hello@acegalaxy.co>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": "github:acegalaxy-co/lib-notion-vault",
  "bugs": {
    "url": "https://github.com/acegalaxy-co/lib-notion-vault/issues"
  },
  "homepage": "https://github.com/acegalaxy-co/lib-notion-vault#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}
