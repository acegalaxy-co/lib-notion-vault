  "settings": {
    "hooks": [
      {
        "event": "PostToolUse",
        "matcher": "Bash",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-bash-stuck-detector.sh"
      },
      {
        "event": "PostToolUse",
        "matcher": "Edit|Write|MultiEdit",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-advisor.sh"
      },
      {
        "event": "PreCompact",
        "matcher": "auto",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact-guard.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-gate.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-browser-profile-gate.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-deploy-doc.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-content-scan.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-orchestrator-gate.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-service-alert-gate.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Read|Edit|Write|MultiEdit",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-read-inject-dir-doc.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "Task",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-task-dispatch-gate.sh"
      },
      {
        "event": "PreToolUse",
        "matcher": "mcp__(pw_|cloak|playwright|browser).*",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-browser-profile-gate.sh"
      },
      {
        "event": "SessionStart",
        "matcher": "",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
      },
      {
        "event": "SubagentStop",
        "matcher": "",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop-record.sh"
      }
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf .git:*)",
      "Edit(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./**/*.pem)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)"
    ],
    "allow": [
      "Bash"
    ],
    "env": {
      "HARNESS_DELEGATE": "1",
      "HARNESS_RISK_DIRS": ""
    },
    "statusLineCommand": "bash $CLAUDE_PROJECT_DIR/.claude/statusline-orchestration.sh"
  }
